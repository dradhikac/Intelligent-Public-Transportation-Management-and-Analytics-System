# TransitIQ Database & Server Environment Configuration
# Copy this file to .env and set your local PostgreSQL credentials

# PostgreSQL 18 Connection Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=transitiq_db
DB_USER=postgres
DB_PASSWORD=postgres

# Connection Pool Settings
DB_MIN_CONN=2
DB_MAX_CONN=15

# API Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False
